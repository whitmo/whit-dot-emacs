#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
cd "$repo_root"

emacs_bin=${EMACS:-emacs}

if ! command -v "$emacs_bin" >/dev/null 2>&1; then
  echo "FAIL: emacs executable not found: $emacs_bin" >&2
  exit 127
fi

log=$(mktemp "${TMPDIR:-/tmp}/emacs-check.XXXXXX")
trap 'rm -f "$log"' EXIT

if "$emacs_bin" -Q --batch \
  --eval "(setq user-emacs-directory (file-name-as-directory default-directory) package-user-dir (expand-file-name \"elpa\" user-emacs-directory))" \
  -l init.el \
  --eval "(message \"LOAD-OK\")" >"$log" 2>&1; then
  if grep -q "LOAD-OK" "$log"; then
    echo "PASS: init.el batch-loads successfully"
    grep -E "(LOAD-OK|Warning|Error setting nil)" "$log" || true
  else
    echo "FAIL: Emacs exited successfully but LOAD-OK marker was missing" >&2
    cat "$log" >&2
    exit 1
  fi
else
  rc=$?
  echo "FAIL: init.el batch load failed with exit code $rc" >&2
  cat "$log" >&2
  exit "$rc"
fi
